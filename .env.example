# Set the canonical public URL before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional customer authentication origin; normally the same as NEXT_PUBLIC_SITE_URL.
# BETTER_AUTH_URL=http://localhost:3000
# Optional random secret (at least 32 characters). Never commit a real value.
# When omitted, a random secret is created once in RISTET_DATA_DIR/customer-auth.secret.
# BETTER_AUTH_SECRET=

# Optional absolute path to a writable, persistent directory (SQLite + uploads).
# Defaults to .data in the project root. Back up the directory before deployment.
# RISTET_DATA_DIR=/var/lib/ristet

# Optional scrypt-v1 hash from npm run admin:setup; never use a plain password here.
# Otherwise the hash is read from RISTET_DATA_DIR/admin-password.hash.
# ADMIN_PASSWORD_HASH=

# Payment is closed by default. Start with test, never a live key for development.
RISTET_CHECKOUT_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after MobilePay is activated in the Stripe account.
STRIPE_MOBILEPAY_ENABLED=false
# Version identifier of approved terms; required for live mode.
RISTET_TERMS_VERSION=
