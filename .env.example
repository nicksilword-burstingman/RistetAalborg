# Set the canonical public URL before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional absolute path to a writable, persistent directory (SQLite + uploads).
# Defaults to .data in the project root. Back up the directory before deployment.
# RISTET_DATA_DIR=/var/lib/ristet

# Optional scrypt-v1 hash from npm run admin:setup; never use a plain password here.
# Otherwise the hash is read from RISTET_DATA_DIR/admin-password.hash.
# ADMIN_PASSWORD_HASH=
